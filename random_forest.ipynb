    "import pandas as pd\n",
    "import numpy as np\n",
    "import datetime as dt\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Read CSV\n",
    "df = pd.read_csv(\"data/dataset-merged-2.csv\")\n",
    "df=df.drop(columns=[\"Restaurant\", \"Terrasse\"]) #prevent data leakage\n",
    "display(df)"
   ]
  },
