    "    refit=True,\n",
    "    verbose=1,\n",
    ")\n",
    "\n",
    "# Map training targets logarithmically\n",
    "y_train_log = np.log1p(y_train)\n",
    "\n",
    "# Fit search only on training data\n",
    "search.fit(X_train, y_train_log)\n",
    "print(\"\\nBest Params:\", search.best_params_)\n",
