    "    max_iter=200,\n",
    "    random_state=72\n",
    ")\n",
    "\n",
    "# Initializing pipeline with model and scaler\n",
    "pipeline = Pipeline([\n",
    "    (\"scaler\", StandardScaler()),\n",
    "    (\"model\", gb)\n",
    "])\n",
    "\n",
    "param_distributions = {\n",
    "    \"model__learning_rate\": [0.005, 0.01, 0.02],\n",
